# Copy to .env for local development, or set these in the PythonAnywhere WSGI file.

# Secrets - generate strong random values in production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_EXPIRES_DAYS=7

# Database.
# Local (leave unset to use the bundled SQLite file), or a local MySQL:
#   DATABASE_URL=mysql+pymysql://root:password@localhost/pastemaster
# PythonAnywhere MySQL (note the user$dbname form and the -services host):
#   DATABASE_URL=mysql+pymysql://YOURUSER:DBPASSWORD@YOURUSER.mysql.pythonanywhere-services.com/YOURUSER$pastemaster
# DATABASE_URL=

# CORS - comma-separated allowed frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Paste rules.
TEMP_PASTE_TTL_HOURS=24
MAX_PASTE_BYTES=3145728

# Rate limiting.
RATELIMIT_DEFAULT=200 per hour

# Deploy webhook (CI/CD). Leave DEPLOY_TOKEN unset to disable POST /api/deploy.
# Set it to a long random secret (python -c "import secrets; print(secrets.token_urlsafe(32))")
# and give the same value to Jenkins as the 'pastemaster-deploy-token' credential.
# DEPLOY_TOKEN=
# WSGI_FILE is touched to reload the app after a pull (PythonAnywhere path):
#   WSGI_FILE=/var/www/YOURUSER_pythonanywhere_com_wsgi.py
# DEPLOY_REPO_DIR defaults to the repo root; override only if the tree lives elsewhere.
# PA_PROXY lets git reach GitHub through PythonAnywhere's free-tier proxy:
#   PA_PROXY=http://proxy.server:3128
